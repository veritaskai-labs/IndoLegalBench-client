# FastAPI base URL, served by the IndoLegalBench-server repo
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Same-origin Langfuse UI at /ai-monitoring. Read by the Next server only.
# The upstream must be the local Langfuse, never https://*.langfuse.com.
# LANGFUSE_UPSTREAM=http://127.0.0.1:3000
# Host header Langfuse expects. Match its NEXTAUTH_URL host.
# LANGFUSE_UPSTREAM_HOST=127.0.0.1:3000
# LANGFUSE_PUBLIC_ORIGIN=
# UI session so /ai-monitoring does not ask for a second login. Do not commit the password.
# LANGFUSE_VIEW_EMAIL=
# LANGFUSE_VIEW_PASSWORD=
# Bench API used to allow only Admin and Developer AI through the view.
# BENCH_API_ORIGIN=http://127.0.0.1:8000
