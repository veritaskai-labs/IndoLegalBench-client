# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# .env.local is never committed. See CONTRIBUTING.md section 10 for the
# rules on secret files.

# FastAPI base URL, served by the IndoLegalBench-server repo
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Added by other sub tasks ---
#
# Zitadel OIDC variables will be added by the authentication sub tasks
# (SCRUM-90 and SCRUM-94). Do not guess their names here.
#
# If your sub task needs a new variable, add it to this file with a
# placeholder value in the same PR, so nobody is left guessing after they
# pull your change.
